# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Required for Phase 2 (Stripe webhooks, Vercel domains). Optional in MVP.
SUPABASE_SERVICE_ROLE_KEY=

# Apex domain that serves the marketing site + dashboard.
# Tenant sites are served from {subdomain}.{ROOT_DOMAIN}.
# For local dev use lvh.me:3000 (resolves to 127.0.0.1 with wildcard subdomains).
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000
